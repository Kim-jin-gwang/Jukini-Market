# Server
PORT=8010
COOKIE_SECRET=change_me_to_a_long_random_string
NODE_ENV=development

# Database — 둘 중 하나의 방식 사용
# 1) 접속 URL 한 줄 (Neon/Render 등):
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# 2) 개별 항목:
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=jukini_development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DIALECT=postgres
# 로컬 테스트용 SQLite: DB_DIALECT=sqlite (DB_STORAGE로 파일 경로 지정 가능)

# Demo
SIGNUP_POINT=1000000
SEED_PASSWORD=jukini1234
